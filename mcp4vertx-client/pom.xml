<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.mcp4vertx</groupId>
    <artifactId>mcp4vertx-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mcp4vertx-client</artifactId>
  <name>mcp4vertx :: Client</name>
  <description>MCP client and HTTP/SSE/stdio client transports built on the Vert.x core HTTP client.</description>
  <url>https://github.com/mcp4vertx/mcp4vertx/tree/main/mcp4vertx-client</url>
  <dependencies>
    <dependency><groupId>io.github.mcp4vertx</groupId><artifactId>mcp4vertx-core</artifactId></dependency>
    <!--
      The transports use io.vertx.core.http.HttpClient directly, so vertx-core is a
      first-class dependency here and not just something inherited from mcp4vertx-core.
      Declared explicitly so that stays true if the core module's own dependencies change.
    -->
    <dependency><groupId>io.vertx</groupId><artifactId>vertx-core</artifactId></dependency>
  </dependencies>
</project>
