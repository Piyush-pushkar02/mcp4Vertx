# Normalise line endings. Everything Git decides is text is stored with LF in the
# repository and checked out with LF on every platform, so a Windows contributor
# cannot accidentally turn a whole file into a CRLF diff.
* text=auto eol=lf

# Explicit for the file types this project contains, so the guess above never has
# to be made for them.
*.java   text eol=lf diff=java
*.xml    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf
LICENSE  text eol=lf
NOTICE   text eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binaries: never touch, never diff as text.
*.jar    binary
*.zip    binary
*.gz     binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.pdf    binary

# Keep generated and vendored files out of language statistics and collapsed in
# pull request diffs.
docs/**            linguist-documentation
*.md               linguist-documentation
